@startuml dd
title RootishArrayStack - Diagrama de flujo detallado

' ============================================================
' Constructor
' ============================================================
start
:RootishArrayStack();
:n = 0;
note right: Inicializa el número de elementos a 0.\nLos bloques se crean dinámicamente.

' ============================================================
' add(i, x)
' ============================================================
partition "add(i, x)" {
  :r = blocks.size();
  note right: r = número de bloques actuales.
  if (r*(r+1)/2 < n + 1) then (sí, falta capacidad)
    :grow();
    note right: Añade un nuevo bloque de tamaño r+1.
  else (no, hay capacidad)
  endif
  :n++;
  :j = n - 1;
  while (j > i) is (sí)
    :set(j, get(j-1));
    note right: Desplaza elementos a la derecha.
    :j--;
  endwhile (no)
  :set(i, x);
  note right: Inserta x en la posición i.
}

' ============================================================
' remove(i)
' ============================================================
partition "remove(i)" {
  :x = get(i);
  note right: Guarda el elemento a eliminar.
  :j = i;
  while (j < n - 1) is (sí)
    :set(j, get(j+1));
    note right: Desplaza elementos a la izquierda.
    :j++;
  endwhile (no)
  :n--;
  :r = blocks.size();
  if ((r-2)*(r-1)/2 >= n) then (sí, sobran bloques)
    :shrink();
    note right: Elimina bloques vacíos desde el final.
  else (no)
  endif
  :return x;
}

' ============================================================
' get(i)
' ============================================================
partition "get(i)" {
  :b = i2b(i);
  note right: Calcula el bloque b que contiene al índice i.
  :j = i - b*(b+1)/2;
  note right: Calcula el desplazamiento dentro del bloque b.
  :return blocks.get(b)[j];
}

' ============================================================
' set(i, x)
' ============================================================
partition "set(i, x)" {
  :b = i2b(i);
  :j = i - b*(b+1)/2;
  :y = blocks.get(b)[j];
  :blocks.get(b)[j] = x;
  :return y;
}

' ============================================================
' i2b(i) - índice a bloque
' ============================================================
partition "i2b(i)" {
  :db = (-3.0 + sqrt(9.0 + 8.0*i)) / 2.0;
  note right: Resuelve b(b+1)/2 <= i < (b+1)(b+2)/2
  :b = (int)ceil(db);
  :return b;
}

' ============================================================
' grow()
' ============================================================
partition "grow()" {
  :blocks.add(blocks.size(), new T[blocks.size()+1]);
  note right: Añade un bloque al final con tamaño = r+1.
}

' ============================================================
' shrink()
' ============================================================
partition "shrink()" {
  :r = blocks.size();
  while (r > 0 && (r-2)*(r-1)/2 >= n) is (sí)
    :delete[] blocks.remove(blocks.size()-1);
    note right: Libera el último bloque.
    :r--;
  endwhile (no)
}

' ============================================================
' clear()
' ============================================================
partition "clear()" {
  while (blocks.size() > 0) is (sí)
    :delete[] blocks.remove(blocks.size()-1);
    note right: Elimina todos los bloques.
  endwhile (no)
  :n = 0;
}

' ============================================================
' Destructor
' ============================================================
partition "~RootishArrayStack()" {
  :clear();
  note right: Libera toda la memoria reservada.
}

stop
@enduml